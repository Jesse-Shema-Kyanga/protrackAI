# Common Node.js ignores
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# Environment variables (real secrets — never commit these)
.env
.env.local
.env.development.local
.env.test.local
# Note: .env.production is intentionally NOT ignored — it only contains the public backend URL

# Logs
*.log
backend/debug_api.log
backend/agent.log
backend/manual_agent.log

# Build outputs
dist/
build/
.cache/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Project-specific ignores
*.txt
backend/ai/model/hash.txt