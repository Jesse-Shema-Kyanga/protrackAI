{
  "name": "protrackai-agent",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron main.js",
    "dev": "electron main.js --enable-logging",
    "build": "electron-builder"
  },
  "build": {
    "appId": "rw.mtn.protrackai.agent",
    "productName": "ProTrackAI Agent",
    "directories": {
      "output": "../../dist/agent"
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "active-window": "^0.1.0",
    "axios": "^1.7.7",
    "electron-store": "^8.2.0",
    "node-machine-id": "^1.1.12"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^25.1.8"
  }
}
